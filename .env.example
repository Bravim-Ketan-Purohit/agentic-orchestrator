# Database
DATABASE_URL=postgresql+asyncpg://orchestrator:orchestrator@localhost:7602/orchestrator
DATABASE_URL_SYNC=postgresql://orchestrator:orchestrator@localhost:7602/orchestrator

# SQS (ElasticMQ local)
SQS_ENDPOINT_URL=http://localhost:7604
SQS_QUEUE_URL=http://localhost:7604/000000000000/runs
SQS_DLQ_URL=http://localhost:7604/000000000000/runs-dlq
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# SNS (LocalStack)
SNS_ENDPOINT_URL=http://localhost:7608
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:run-completions

# WebSocket
WS_ORIGIN_ALLOWLIST=http://localhost:7600,http://localhost:3000
WS_HEARTBEAT_INTERVAL=20
WS_SEND_QUEUE_MAX=1024

# LISTEN/NOTIFY poll fallback interval (ms)
NOTIFY_POLL_INTERVAL_MS=300

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:7607
OTEL_SERVICE_NAME=orchestrator
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_ENABLED=true

# API
API_HOST=0.0.0.0
API_PORT=7601
